    <ui:VisualElement name="HealthBarMask" style="flex-grow: 1; position: absolute; width: 362px; height: 35px; top: 59px; left: 114px; overflow: hidden; padding-top: 0; padding-bottom: 0; padding-right: 0; padding-left: 0; background-size: 100% 100%;">
        <ui:VisualElement name="HealthBarFill" style="flex-grow: 1; background-color: rgb(230, 58, 53); position: absolute; width: 100%; height: 100%; overflow: hidden; top: -2px; padding-bottom: 0; padding-top: 0; padding-right: 0; padding-left: 0; background-size: 100% 100%; transition-property: width; transition-duration: 0.5s; transition-timing-function: ease-out-bounce;"/>
